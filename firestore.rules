rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    match /sections/{sectionKey} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
